# Copie para terraform.tfvars se quiser sobrescrever o padrão.
# Não coloque access keys neste arquivo. Credenciais ficam em ~/.aws ou na env.

# aws_profile  = "default"
aws_region   = "us-east-2"
project_name = "arena-store"
environment  = "demo"

