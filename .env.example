# Backend local (sem AWS). Não commite um arquivo .env de verdade.
LISTEN_ADDR=127.0.0.1:8080
ALLOWED_ORIGIN=*

# Timeouts em segundos. No modo local o runner também agenda o relógio de parede.
CART_TTL_SECONDS=900
PIX_TTL_SECONDS=900
CARD_DELAY_SECONDS=8
CARD_DELAY_LONG_SECONDS=20

# Deixe TABLE_NAME e DURABLE_FUNCTION_NAME vazios para memória + durabletest.
# TABLE_NAME=
# DURABLE_FUNCTION_NAME=
